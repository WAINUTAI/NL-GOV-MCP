# Optional API keys — most tools work without any keys
# KNMI weather tools (knmi_*): https://developer.dataplatform.knmi.nl/open-data-api#token
KNMI_API_KEY=
# Overheid API register (overheid_api_register_search): https://apis.developer.overheid.nl/apis/key-aanvragen
OVERHEID_API_KEY=
# Kadaster BAG Individuele Bevragingen (bag_address_detail authoritative oppervlakte/bouwjaar):
# https://www.kadaster.nl/zakelijk/producten/adressen-en-gebouwen/bag-api-individuele-bevragingen
BAG_API_KEY=
# DSO Omgevingsdocumenten Presenteren API (dso_omgevingsdocumenten_search):
# https://developer.omgevingswet.overheid.nl/formulieren/api-key-aanvragen-0/
DSO_API_KEY=
# Nationaal Energie Dashboard (ned_energie_search): https://ned.nl/nl/api
NED_API_KEY=
# RVO EP-Online energielabels (ep_online_energielabel): https://www.ep-online.nl/
EP_ONLINE_API_KEY=
# NS Reisinformatie API (ns_reisinformatie): register at https://apiportal.ns.nl/ then
# SUBSCRIBE TO THE "Ns-App" PRODUCT — it contains the Reisinformatie API (disruptions,
# departures, arrivals, trips) with a free external tier (~300 requests / 5 min). Do NOT use
# the "Public-Travel-Information" product: it only holds the deprecated Price API and NS no
# longer approves new subscriptions. After subscribing, copy the subscription's Primary key
# from your NS portal Profile page into NS_API_KEY.
NS_API_KEY=
# DNB Statistics API — free "Public" product (dnb_statistics_search): https://api.portal.dnb.nl
DNB_API_KEY=

# Transport: stdio (default), sse, or streamable-http
# MCP_TRANSPORT=stdio

# HTTP port for SSE / Streamable HTTP transports
# NL_GOV_HTTP_PORT=3333

# Timezone for natural date parsing (default: Europe/Amsterdam)
# NL_GOV_TIMEZONE=Europe/Amsterdam

# Log level: debug, info, warn, error, silent
# LOG_LEVEL=info
